{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Image Sage Video",
  "version": "0.7.0",
  "identifier": "com.robmirabelle.imagesagevideo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:14420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Image Sage Video",
        "width": 980,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "visible": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "backgroundColor": "#22252f"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "template": "installer.nsi"
      }
    }
  }
}
